        <mxCell id="GxbysH2sBf0InsFubE2b-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontColor=#000000;fillColor=#ffffc0;strokeColor=#ff0000;" value="&lt;div style=&quot;color: rgb(212, 212, 212); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-weight: normal; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(206, 145, 120);&quot;&gt;Inicio: Formulario PEA &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;gf_step_label&quot; style=&quot;color: light-dark(rgb(212, 212, 212), rgb(145, 93, 71));&quot;&gt;Travel &amp;amp; Residence&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
