        </mxCell>
        <mxCell id="40UpWWIaGXdtNQ-cpG8O-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span class=&quot;gform-field-label__text&quot;&gt;You may qualify for an exemption &lt;br&gt;from the residence and physical presence requirements in the United &lt;br&gt;States.  At the same time, this exemption requires providing information&lt;br&gt; which is outside of the scope of services for Naturalization Made Easy &lt;br&gt;(“NME”).  Therefore, please indicate as follows:&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="405" x="440" y="250" as="geometry" />
        </mxCell>
        <mxCell id="yrIqfLYaSQJHpYRzYfIi-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontColor=#000000;fillColor=#ffffc0;strokeColor=light-dark(#FF0000,#3399FF);" value="NEXT PAGE" vertex="1">
          <mxGeometry height="40" width="120" x="450" y="1005" as="geometry" />
        </mxCell>
        <mxCell id="yrIqfLYaSQJHpYRzYfIi-4" edge="1" parent="1" source="40UpWWIaGXdtNQ-cpG8O-3" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;edgeStyle=orthogonalEdgeStyle;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" target="yrIqfLYaSQJHpYRzYfIi-2" value="I wish to take advantage of the exemption to the physical presence and &lt;br/&gt;residence requirements; consequently, I agree that I will either file &lt;br/&gt;for naturalization myself or retain counsel for timely filing on my &lt;br/&gt;eligibility date">
          <mxGeometry relative="1" width="80" x="-0.818" y="56" as="geometry">
            <mxPoint as="offset" />
            <mxPoint x="610" y="440" as="sourcePoint" />
            <mxPoint x="744" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yrIqfLYaSQJHpYRzYfIi-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&#xa;&lt;span class=&quot;gform-field-label__text&quot;&gt;While a Legal Permanent Resident have you traveled outside the U.S. in a single trip for longer than 1 year?&lt;/span&gt;&#xa;&#xa;" vertex="1">
          <mxGeometry height="60" width="320" x="105" y="480" as="geometry" />
