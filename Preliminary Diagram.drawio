        </mxCell>
        <mxCell id="GxbysH2sBf0InsFubE2b-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;span class=&quot;gform-field-label__text&quot;&gt;In the last 5 years did you reside&lt;br&gt; outside the United States due to (a) having a U.S. citizen spouse in the military or (b) having a U.S. citizen spouse who worked outside the U.S. for another organization or company?&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="335" x="258" y="110" as="geometry" />
        </mxCell>
        <mxCell id="40UpWWIaGXdtNQ-cpG8O-1" edge="1" parent="1" source="GxbysH2sBf0InsFubE2b-2" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;edgeStyle=orthogonalEdgeStyle;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="40UpWWIaGXdtNQ-cpG8O-3" value="YES">
